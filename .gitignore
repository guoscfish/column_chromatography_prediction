.DS_Store
__pycache__/
*.py[cod]

# Active-learning runtime artifacts (retain aggregate scientific outputs)
experiments/**/runtime/
experiments/**/progress/
experiments/**/checkpoints/
experiments/**/history.csv
experiments/**/fit_result.json
experiments/**/*.partial.csv
experiments/**/state_round_*.json
experiments/**/state_after_fit.json
experiments/**/state_after_query.json
experiments/**/*.pth
experiments/**/*.ckpt
# Checkpoints are runtime by default. Protected anchors already tracked remain usable.
experiments/**/*.pt

# Current-study runtime is always reproducible and never tracked.
studies/**/runtime/
# A study that still uses a separate progress directory is equally runtime-only.
studies/**/progress/
experiments/e2_*/**/checkpoints/
experiments/e2_*/**/pool_predictions.csv.gz
experiments/e2_*/**/test_predictions.csv.gz
experiments/e2_*/**/history.csv
experiments/e2_*/**/state_after_fit.json
experiments/e2_*/**/state_after_query.json
experiments/e2_*/**/selected_after_reveal.csv
experiments/e2_*/**/member_*/best.pt
experiments/e2_*/**/member_*/fit_result.json
experiments/e2_*/**/round_*/round_metrics.json
experiments/e2_*/**/round_*/compound_macro_metrics.json
experiments/e2_*/**/round_*/queried_batch_diagnostics.json
experiments/e2_*/**/round_*/representation_audit.json
experiments/e2_*/**/round_*/convergence.csv
experiments/e2_*/**/shared_round_0/round0_pool_signals.csv.gz
experiments/e2_*/**/shared_round_0/round0_representations.npz
experiments/e2_*/**/shared_round_0/representation_audit.json
experiments/e2_*/**/scaler.json
experiments/e2_*/resume_pipeline.log

# E4 engineering/formal per-fit runtime (retain aggregate audits and query history)
experiments/e4_*/**/best.pt
experiments/e4_*/**/history.csv
experiments/e4_*/**/fit_result.json
experiments/e4_*/**/state_round_*.json

# D45 per-candidate checkpoints and histories are reproducible scratch data.
experiments/d45_oracle_marginal_utility/runtime/
experiments/reproductions/**/runtime/
experiments/d46_oracle_utility_reliability/runtime/

# New active-learning runtime payloads; already tracked pilot evidence remains tracked.
studies/**/execution.lock
studies/**/catalog.json
studies/**/turn_*.json
studies/**/request_*.json
studies/**/context_audit_*.json
studies/**/audit.jsonl
studies/active_learning/qgeognn_v2_row_llm_scientist_v3_2/initial/
studies/active_learning/qgeognn_v2_row_llm_scientist_v3_2/selections/

studies/**/.operation.lock

studies/active_learning/qgeognn_v2_row_llm_scientist_v3_2/attempts/

# Console output is local; structured status, costs and scientific receipts stay versioned.
studies/**/*.log

# Dual-expert accepted/rejected answers and tiny request-hash receipts are audit
# evidence. Full requests, catalogs, locks and training payloads remain ignored.
!studies/active_learning/qgeognn_v2_row_llm_dual_expert_v1/revisions/**/selections/**/agents/**/turn_*.json

# Full candidate/history requests stay local; compact contracts, selections,
# feedback and request hashes remain versioned. Existing tracked evidence stays.
studies/**/selections/**/input.json
studies/**/selections/**/planner_input.json
studies/**/selections/**/extra_correction_request.json
studies/**/*.lock
.pytest_cache/

# Monitor console streams and kernel locks are local process state.
reports/**/*.log
reports/**/*.lock
reports/**/matplotlib_cache/

# Recomputable acquisition feature arrays; keep contracts and feature hashes.
studies/**/current_center_width_gradient_features.npz

# Presentation raster QA is regenerated from retained final PDFs.
docs/presentation_assets/**/qa/pdf_render/
docs/presentation_assets/**/qa/pdf_preview_*.png
