def version_record(version):
    if version in HISTORY:
        return HISTORY[version]
    record = json.loads((PRIVATE_ROOT / "purellm-a7-v3.json").read_text())
    if not isinstance(record, dict) or set(record) != set(HISTORY["v2"]) or any(
        not isinstance(value, str) for value in record.values()
    ):
        raise ValueError("invalid PureLLM-A7 v3 operator settings")
    effort = record["reasoning_effort"]
    if effort != "max" or record["run_basename"] != "a7-gpt62-max-ssh-v3" or any(
        re.fullmatch(r"[0-9a-f]{64}", record[key]) is None for key in ("contract_sha256", "release_sha256")
    ):
        raise ValueError("invalid PureLLM-A7 v3 contract, release, or run name")
    return record

